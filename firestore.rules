rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- CORE HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasOnlyAllowedFields(fields) {
      return incoming().keys().hasOnly(fields);
    }

    // --- DEVELOPER IDENTIFICATION (Multi-tier Safe Fallback) ---
    // 1. Firebase Auth Custom Claim (server-side forward compatibility)
    // 2. Google OAuth Verified Email Whitelist
    // 3. Automated Test Developer UIDs
    // 4. Dedicated Dev Registry collection lookup
    // 5. Protected User Document Role
    function isDev() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'DEVELOPER' ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in ['admin@khiemthiviet.vn', 'developer@khiemthiviet.vn', 'dev@khiemthiviet.vn']) ||
        request.auth.uid in ['dev_admin_uid', 'dev_super_admin'] ||
        exists(/databases/$(database)/documents/dev_registry/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'DEVELOPER')
      );
    }

    // --- TENANT MEMBERSHIP & ROLE HELPERS ---
    function isTenantMember(tenantId) {
      return isSignedIn() && (
        isDev() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('primaryTenantId', '') == tenantId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tenantId', '') == tenantId)) ||
        tenantId == 'khiem_thi_viet'
      );
    }

    function isTenantActive(tenantId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      return isDev() || !exists(tenantPath) || (
        get(tenantPath).data.get('status', 'ACTIVE') == 'ACTIVE' && 
        get(tenantPath).data.get('isLocked', false) == false
      );
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && (
        isDev() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['OWNER', 'DEVELOPER'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('spaRole', '') == 'ADMIN'))
      );
    }

    // --- WORKSPACE TENANT KILL-SWITCH HELPER ---
    function isWorkspaceTenantActive(workspaceId) {
      let tenantId = (workspaceId == 'khiem_thi_viet_shared') ? 'khiem_thi_viet' : workspaceId;
      return isTenantActive(tenantId);
    }

    // --- WORKSPACE SCHEMA VALIDATOR ---
    function isValidSpaWorkspace(workspaceId) {
      let allowed = [
        'workspaceId',
        'shopName',
        'payloadJson',
        'accountsCount',
        'customersCount',
        'ticketsCount',
        'updatedByUid',
        'updatedByName',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed)
        && incoming().keys().hasAll(allowed)
        && incoming().workspaceId is string
        && incoming().workspaceId == workspaceId
        && incoming().workspaceId.size() >= 1
        && incoming().workspaceId.size() <= 100
        && incoming().shopName is string
        && incoming().shopName.size() >= 1
        && incoming().shopName.size() <= 200
        && incoming().payloadJson is string
        && incoming().payloadJson.size() >= 2
        && incoming().payloadJson.size() <= 900000
        && incoming().accountsCount is int
        && incoming().accountsCount >= 1
        && incoming().accountsCount <= 500
        && incoming().customersCount is int
        && incoming().customersCount >= 0
        && incoming().customersCount <= 10000
        && incoming().ticketsCount is int
        && incoming().ticketsCount >= 0
        && incoming().ticketsCount <= 50000
        && incoming().updatedByUid is string
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedByName is string
        && incoming().updatedByName.size() >= 1
        && incoming().updatedByName.size() <= 200
        && incoming().updatedAt is timestamp
        && incoming().updatedAt <= request.time;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // --- TẦNG 1: DEV CONSOLE & REGISTRY (Chỉ Developer) ---
    match /dev_console/{document=**} {
      allow read, write: if isDev();
    }

    match /dev_registry/{devUid} {
      allow read: if isSignedIn();
      allow write: if isDev();
    }

    // --- USERS (Ánh xạ Firebase Auth → Tenant & Role + Chống leo thang quyền) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isDev());
      // Người dùng bình thường không được tự gắn role DEVELOPER
      allow create: if isDev() || (
        isSignedIn() && request.auth.uid == userId && 
        request.resource.data.get('role', '') != 'DEVELOPER'
      );
      allow update: if isDev() || (
        isSignedIn() && request.auth.uid == userId && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
         request.resource.data.get('role', '') != 'DEVELOPER')
      );
      allow delete: if isDev();
    }

    // --- TẦNG 2-3: TENANTS (Dữ liệu cách ly từng cơ sở & Remote Kill-Switch) ---
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (isDev() || isTenantMember(tenantId));
      allow create: if isDev();
      // Dev toàn quyền; Owner chỉ được update trừ status và isLocked (Kill-Switch)
      allow update: if isDev() || (
        isTenantOwner(tenantId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isLocked'])
      );
      allow delete: if isDev();

      // Sub-collections: Chỉ ghi khi tenant ACTIVE
      match /staff/{staffId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /accounts/{accountId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /services/{serviceId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /service_packages/{packageId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /customers/{customerId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /package_subscriptions/{subId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /tickets/{ticketId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /cashbook/{entryId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /ai_conversations/{sessionId} {
        allow read, write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /ai_memories/{memoryId} {
        allow read, write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /subscription_invoices/{invoiceId} {
        allow read: if isDev() || isTenantOwner(tenantId);
        allow write: if isDev();
      }
    }

    // --- TẦNG ĐỒNG BỘ ĐÁM MÂY: SPA WORKSPACES ---
    // Phục vụ SpaStore.kt realtime sync, bảo vệ schema, kiểm soát Kill-Switch và chống xóa
    match /spa_workspaces/{workspaceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidSpaWorkspace(workspaceId) 
                    && isWorkspaceTenantActive(workspaceId);
      allow update: if isSignedIn() 
                    && isValidSpaWorkspace(workspaceId) 
                    && isWorkspaceTenantActive(workspaceId)
                    && incoming().workspaceId == existing().workspaceId;
      allow delete: if false; // Tuyệt đối bảo vệ, không cho xóa không gian chung
    }
  }
}
