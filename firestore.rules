rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Developer được nhận diện qua Firebase Custom Claims: request.auth.token.role == 'DEVELOPER'
    function isDev() {
      return isSignedIn() && request.auth.token.get('role', '') == 'DEVELOPER';
    }
    
    // Kiểm tra user thuộc tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.primaryTenantId == tenantId;
    }
    
    // Kiểm tra tenant ACTIVE (Kill-Switch): đọc document /tenants/{tenantId}
    function isTenantActive(tenantId) {
      let t = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      return t.status == 'ACTIVE' && t.isLocked == false;
    }
    
    // Kiểm tra Owner (Chủ Spa) của tenant
    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    // --- TẦNG 1: DEV CONSOLE (Chỉ Developer) ---
    match /dev_console/{document=**} {
      allow read, write: if isDev();
    }

    // --- USERS (Ánh xạ Firebase Auth → Tenant & Role) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isDev());
      allow write: if isDev() || (isSignedIn() && request.auth.uid == userId);
    }

    // --- TẦNG 2-3: TENANTS (Dữ liệu cách ly hoàn toàn từng Spa) ---
    match /tenants/{tenantId} {
      // Chỉ Dev mới được đổi status/isLocked (Kill-Switch)
      allow read: if isSignedIn() && (isDev() || isTenantMember(tenantId));
      allow create: if isDev();
      // Update: Dev full quyền; Owner chỉ được update trừ status và isLocked
      allow update: if isDev() || (isTenantOwner(tenantId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isLocked']));
      allow delete: if isDev();

      // Sub-collections: Chỉ ghi khi tenant ACTIVE
      match /staff/{staffId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /accounts/{accountId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /services/{serviceId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /service_packages/{packageId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /customers/{customerId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /package_subscriptions/{subId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /tickets/{ticketId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /cashbook/{entryId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && isTenantActive(tenantId);
      }
      match /ai_conversations/{sessionId} {
        allow read, write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /ai_memories/{memoryId} {
        allow read, write: if isTenantOwner(tenantId) && isTenantActive(tenantId);
      }
      match /subscription_invoices/{invoiceId} {
        allow read: if isDev() || isTenantOwner(tenantId);
        allow write: if isDev();
      }
    }

    // Legacy: Giữ lại cấu trúc cũ cho đến khi hoàn tất di chuyển toàn bộ
    match /spa_workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isDev() || isTenantActive("khiem_thi_viet"));
    }
  }
}
